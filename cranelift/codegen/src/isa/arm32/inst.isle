;; Flag producers.
(decl cmp_rr (Reg Reg) ProducesFlags)
(rule (cmp_rr rn rm)
  (ProducesFlags.ProducesFlagsSideEffect (MInst.CmpRR (CmpOp.Cmp) rn rm (shift_none))))

(decl cmp_rr_shift (Reg Reg ShiftOpAndAmt) ProducesFlags)
(rule (cmp_rr_shift rn rm shift)
  (ProducesFlags.ProducesFlagsSideEffect (MInst.CmpRR (CmpOp.Cmp) rn rm shift)))

(decl cmp_imm (Reg ModImm) ProducesFlags)
(rule (cmp_imm rn imm)
  (ProducesFlags.ProducesFlagsSideEffect (MInst.CmpRImm (CmpOp.Cmp) rn imm)))

(decl cmn_imm (Reg ModImm) ProducesFlags)
(rule (cmn_imm rn imm)
  (ProducesFlags.ProducesFlagsSideEffect (MInst.CmpRImm (CmpOp.Cmn) rn imm)))

(decl tst_imm (Reg ModImm) ProducesFlags)
(rule (tst_imm rn imm)
  (ProducesFlags.ProducesFlagsSideEffect (MInst.CmpRImm (CmpOp.Tst) rn imm)))

(decl tst_rr (Reg Reg) ProducesFlags)
(rule (tst_rr rn rm)
  (ProducesFlags.ProducesFlagsSideEffect (MInst.CmpRR (CmpOp.Tst) rn rm (shift_none))))

;; Compare a 64-bit pair for (in)equality or an unsigned relation:
;; `cmp hi_a, hi_b; cmpeq lo_a, lo_b`.
(decl cmp64_unsigned (ValueRegs ValueRegs) ProducesFlags)
(rule (cmp64_unsigned a b)
  (ProducesFlags.ProducesFlagsTwiceSideEffect
    (MInst.CmpRR (CmpOp.Cmp) (value_regs_get a 1) (value_regs_get b 1) (shift_none))
    (MInst.CCmpRR (CmpOp.Cmp) (Cond.Eq) (value_regs_get a 0) (value_regs_get b 0))))

;; Compare a 64-bit pair for a signed less-than/greater-or-equal relation:
;; `cmp lo_a, lo_b; sbcs tmp, hi_a, hi_b`.
(decl cmp64_signed (ValueRegs ValueRegs) ProducesFlags)
(rule (cmp64_signed a b)
  (let ((tmp WritableReg (temp_i32)))
    (ProducesFlags.ProducesFlagsTwiceSideEffect
      (MInst.CmpRR (CmpOp.Cmp) (value_regs_get a 0) (value_regs_get b 0) (shift_none))
      (MInst.AluRRR (AluOp.Sbc) true tmp (value_regs_get a 1) (value_regs_get b 1) (shift_none)))))

;; `vcmp; vmrs`
(decl fpu_cmp (FpuSize Reg Reg) ProducesFlags)
(rule (fpu_cmp size rn rm)
  (ProducesFlags.ProducesFlagsSideEffect (MInst.FpuCmp size rn rm)))

;; Flag consumers.
(decl csel (Cond Reg Reg) ConsumesFlags)
(rule (csel cond rn rm)
  (let ((rd WritableReg (temp_i32)))
    (ConsumesFlags.ConsumesFlagsReturnsReg (MInst.CSel rd cond rn rm) rd)))

;; `rd = cond ? imm : rm`
(decl csel_imm (Cond ModImm Reg) ConsumesFlags)
(rule (csel_imm cond imm rm)
  (let ((rd WritableReg (temp_i32)))
    (ConsumesFlags.ConsumesFlagsReturnsReg (MInst.CSelImm (MovOp.Mov) rd cond imm rm) rd)))

;; `rd = cond ? ~imm : rm`
(decl csel_inv_imm (Cond ModImm Reg) ConsumesFlags)
(rule (csel_inv_imm cond imm rm)
  (let ((rd WritableReg (temp_i32)))
    (ConsumesFlags.ConsumesFlagsReturnsReg (MInst.CSelImm (MovOp.Mvn) rd cond imm rm) rd)))

(decl fpu_csel (FpuSize Cond Reg Reg) ConsumesFlags)
(rule (fpu_csel size cond rn rm)
  (let ((rd WritableReg (temp_f64)))
    (ConsumesFlags.ConsumesFlagsReturnsReg (MInst.FpuCSel size rd cond rn rm) rd)))

;; Select a register pair.
(decl csel64 (Cond ValueRegs ValueRegs) ConsumesFlags)
(rule (csel64 cond a b)
  (let ((lo WritableReg (temp_i32))
        (hi WritableReg (temp_i32)))
    (ConsumesFlags.ConsumesFlagsTwiceReturnsValueRegs
      (MInst.CSel lo cond (value_regs_get a 0) (value_regs_get b 0))
      (MInst.CSel hi cond (value_regs_get a 1) (value_regs_get b 1))
      (value_regs lo hi))))

(decl cset (Cond) ConsumesFlags)
(rule (cset cond)
  (let ((rd WritableReg (temp_i32)))
    (ConsumesFlags.ConsumesFlagsReturnsReg (MInst.CSet rd cond) rd)))

(decl csetm (Cond) ConsumesFlags)
(rule (csetm cond)
  (let ((rd WritableReg (temp_i32)))
    (ConsumesFlags.ConsumesFlagsReturnsReg (MInst.CSetm rd cond) rd)))

;; `rd = cond1 || cond2 ? 1 : 0`
(decl cset2 (Cond Cond) ConsumesFlags)
(rule (cset2 c1 c2)
  (let ((rd WritableReg (temp_i32))
        (rd2 WritableReg (temp_i32))
        (one Reg (imm32 1)))
    (ConsumesFlags.ConsumesFlagsTwiceReturnsValueRegs
      (MInst.CSet rd c1)
      (MInst.CSel rd2 c2 one rd)
      (value_reg rd2))))

;; A conditional comparison against an immediate: `cmp{cond} rn, #imm`.
(decl ccmp_imm (Cond Reg ModImm) MInst)
(rule (ccmp_imm cond rn imm) (MInst.CCmpRImm (CmpOp.Cmp) cond rn imm))

;; A modified immediate that is known to be encodable.
(decl mod_imm (u32) ModImm)
(extern constructor mod_imm mod_imm)

(decl pure intcc_signed (IntCC) bool)
(extern constructor intcc_signed intcc_signed)

;; Conditions for a floating-point comparison: either one condition, or
;; the disjunction of two.
(type FloatCond
  (enum
    (One (c Cond))
    (Two (c1 Cond) (c2 Cond))))

(decl pure float_cond (FloatCC) FloatCond)
(extern constructor float_cond float_cond)

;; A flags-producing sequence along with the condition to test.
(type FlagsAndCC
  (enum
    (FlagsAndCC
      (flags ProducesFlags)
      (cc Cond))))

(decl cond_br (MachLabel MachLabel Cond) ConsumesFlags)
(rule (cond_br taken not_taken cond)
  (ConsumesFlags.ConsumesFlagsSideEffect (MInst.CondBr taken not_taken cond)))

(decl trap_if (Cond TrapCode) ConsumesFlags)
(rule (trap_if cond tc)
  (ConsumesFlags.ConsumesFlagsSideEffect (MInst.TrapIf cond tc)))

;; Unconditional jump.
(decl jump_to (MachLabel) SideEffectNoResult)
(rule (jump_to label) (SideEffectNoResult.Inst (MInst.Jump label)))

;; Misc.
(decl udf (TrapCode) SideEffectNoResult)
(rule (udf tc) (SideEffectNoResult.Inst (MInst.Udf tc)))

(decl bkpt () SideEffectNoResult)
(rule (bkpt) (SideEffectNoResult.Inst (MInst.Bkpt)))

(decl arm_fence () SideEffectNoResult)
(rule (arm_fence) (SideEffectNoResult.Inst (MInst.Fence)))

