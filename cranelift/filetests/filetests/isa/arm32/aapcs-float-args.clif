; block0:
;   vmov.f64 d1, #1.0
;   ldr r0, =%callee+0
;   vmov.f64 d2, d8
;   blx r0
;   vpop {d8-d8}
;   pop {fp, pc}
;
; Disassembled:
; block0: ; offset 0x0
;   push {fp, lr}
;   mov fp, sp
;   vpush {d8}
; block1: ; offset 0xc
;   vmov.f32 s16, s1
;   vmov.f64 d1, #1.000000e+00
;   ldr r0, [pc]
;   b #0x20
;   andeq r0, r0, r0 ; reloc_external Abs4 %callee 0
;   vmov.f64 d2, d8
;   vmov.f32 s1, s16
;   blx r0
;   vpop {d8}
;   pop {fp, pc}

