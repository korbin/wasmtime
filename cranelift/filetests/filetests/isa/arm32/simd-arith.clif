test compile precise-output
set unwind_info=false
target armv7 has_neon

;; i64x2 multiplication from 32-bit NEON products.
function %imul_i64x2(i64x2, i64x2) -> i64x2 {
block0(v0: i64x2, v1: i64x2):
    v2 = imul v0, v1
    return v2
}

; VCode:
; block0:
;   vmov q10, q8
;   vmov q11, q9
;   vmul.i64x q9, q10, q11 ; tmp q8
;   vmov q8, q9
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   vorr q10, q8, q8
;   vorr q11, q9, q9
;   vrev64.32 q9, q11
;   vmul.i32 q9, q9, q10
;   vpaddl.u32 q9, q9
;   vshl.i64 q9, q9, #0x20
;   vmovn.i64 d16, q10
;   vmovn.i64 d17, q11
;   vmlal.u32 q9, d16, d17
;   vorr q8, q9, q9
;   bx lr

