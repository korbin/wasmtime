;; Two guarded accesses at different offsets from the same `base + index`:
;; each recomputes the sum instead of copying it, so it is never needed on
;; its own.
function %guarded_shared_base(i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32):
    v3 = icmp ugt v1, v2
    v4 = iadd v0, v1
    v5 = iconst.i32 16
    v6 = iadd v4, v5
    v7 = iconst.i32 0
    v8 = select_spectre_guard v3, v7, v6
    v9 = load.i32 little v8
    v10 = iconst.i32 20
    v11 = iadd v4, v10
    v12 = select_spectre_guard v3, v7, v11
    v13 = load.i32 little v12
    v14 = iadd v9, v13
    return v14
}

