function %guarded_store_f64_offset(i32, i32, i32, f64) {
block0(v0: i32, v1: i32, v2: i32, v3: f64):
    v4 = icmp uge v1, v2
    v5 = iadd v0, v1
    v6 = iconst.i32 248
    v7 = iadd v5, v6
    v8 = iconst.i32 0
    v9 = select_spectre_guard v4, v8, v7
    store.f64 little v3, v9
    return
}

