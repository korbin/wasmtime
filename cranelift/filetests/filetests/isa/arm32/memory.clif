function %guarded_load_i64_offset(i32, i32, i32) -> i64 {
block0(v0: i32, v1: i32, v2: i32):
    v3 = icmp ugt v1, v2
    v4 = iadd v0, v1
    v5 = iconst.i32 8
    v6 = iadd v4, v5
    v7 = iconst.i32 0
    v8 = select_spectre_guard v3, v7, v6
    v9 = load.i64 little v8
    return v9
}

