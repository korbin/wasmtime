test compile precise-output
set unwind_info=false
target armv7 has_neon

;; Loads that feed a splat, `scalar_to_vector` or a widening go straight into
;; NEON registers.

function %load8_splat(i32) -> i8x16 {
block0(v0: i32):
    v1 = load.i8 v0
    v2 = splat.i8x16 v1
    return v2
}

; VCode:
; block0:
;   vld1.8 {q8.d0[], q8.d1[]}, [r0]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   vld1.8 {d16[], d17[]}, [r0] ; trap: heap_oob
;   bx lr

function %load16_splat(i32) -> i16x8 {
block0(v0: i32):
    v1 = load.i16 v0+6
    v2 = splat.i16x8 v1
    return v2
}

; VCode:
; block0:
;   vld1.16 {q8.d0[], q8.d1[]}, [r0, #6]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   add ip, r0, #6
;   vld1.16 {d16[], d17[]}, [ip] ; trap: heap_oob
;   bx lr

function %load_f32_splat(i32) -> f32x4 {
block0(v0: i32):
    v1 = load.f32 v0+0x2000
    v2 = splat.f32x4 v1
    return v2
}

; VCode:
; block0:
;   vld1.32 {q8.d0[], q8.d1[]}, [r0, #8192]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   add ip, r0, #0x2000
;   vld1.32 {d16[], d17[]}, [ip] ; trap: heap_oob
;   bx lr

function %load32_zero(i32) -> i32x4 {
block0(v0: i32):
    v1 = load.i32 v0+4
    v2 = scalar_to_vector.i32x4 v1
    return v2
}

; VCode:
; block0:
;   vmov.i32 q8, #0 ; vld1.32 {q8.d0[0]}, [r0, #4]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   vmov.i32 q8, #0
;   add ip, r0, #4
;   vld1.32 {d16[0]}, [ip] ; trap: heap_oob
;   bx lr

function %load64_zero(i32) -> i64x2 {
block0(v0: i32):
    v1 = load.i64 v0
    v2 = scalar_to_vector.i64x2 v1
    return v2
}

; VCode:
; block0:
;   vmov.i32 q8, #0 ; vld1.8 {q8.d0}, [r0]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   vmov.i32 q8, #0
;   vld1.8 {d16}, [r0] ; trap: heap_oob
;   bx lr

function %sload16x4(i32) -> i32x4 {
block0(v0: i32):
    v1 = sload16x4 v0+8
    return v1
}

; VCode:
; block0:
;   vld1.8 {q8.d0}, [r0, #8]
;   vmovl.s16 q8, q8.lo
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   add ip, r0, #8
;   vld1.8 {d16}, [ip] ; trap: heap_oob
;   vmovl.s16 q8, d16
;   bx lr

function %uload8x8(i32) -> i16x8 {
block0(v0: i32):
    v1 = uload8x8 v0
    return v1
}

; VCode:
; block0:
;   vld1.8 {q8.d0}, [r0]
;   vmovl.u8 q8, q8.lo
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   vld1.8 {d16}, [r0] ; trap: heap_oob
;   vmovl.u8 q8, d16
;   bx lr

;; The load also has another use, so it isn't merged into the splat.
function %load_splat_shared(i32) -> i8x16, i8 {
block0(v0: i32):
    v1 = load.i8 v0
    v2 = splat.i8x16 v1
    return v2, v1
}

; VCode:
; block0:
;   ldrb r0, [r0]
;   vdup.8 q8, r0
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   ldrb r0, [r0] ; trap: heap_oob
;   vdup.8 q8, r0
;   bx lr


;; Lane loads and stores (`v128.load*_lane`, `v128.store*_lane`).
function %load8_lane(i32, i8x16) -> i8x16 {
block0(v0: i32, v1: i8x16):
    v2 = load.i8 v0
    v3 = insertlane v1, v2, 13
    return v3
}

; VCode:
; block0:
;   vld1.8 {q8.d1[5]}, [r0]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   vld1.8 {d17[5]}, [r0] ; trap: heap_oob
;   bx lr

function %load64_lane(i32, i64x2) -> i64x2 {
block0(v0: i32, v1: i64x2):
    v2 = load.i64 v0+3
    v3 = insertlane v1, v2, 1
    return v3
}

; VCode:
; block0:
;   vld1.8 {q8.d1}, [r0, #3]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   add ip, r0, #3
;   vld1.8 {d17}, [ip] ; trap: heap_oob
;   bx lr

function %store16_lane(i32, i16x8) {
block0(v0: i32, v1: i16x8):
    v2 = extractlane v1, 5
    store v2, v0
    return
}

; VCode:
; block0:
;   vst1.16 {q8.d1[1]}, [r0]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   vst1.16 {d17[1]}, [r0] ; trap: heap_oob
;   bx lr

function %store_f32_lane(i32, f32x4) {
block0(v0: i32, v1: f32x4):
    v2 = extractlane v1, 2
    store v2, v0+0x1000
    return
}

; VCode:
; block0:
;   vst1.32 {q8.d1[0]}, [r0, #4096]
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   add ip, r0, #0x1000
;   vst1.32 {d17[0]}, [ip] ; trap: heap_oob
;   bx lr

