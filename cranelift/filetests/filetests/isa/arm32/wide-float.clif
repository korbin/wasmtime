test compile precise-output
set unwind_info=false
set opt_level=speed
target armv7 has_neon has_vfp4

;; With NEON, functions without vector values can also allocate scalar floats
;; to d16-d31 (the halves of q8-q15). Values accessed as S registers are
;; limited to d0-d15.

function %f64_pressure(i32) -> f64 {
block0(v0: i32):
    v1 = load.f64 aligned v0+0
    v2 = load.f64 aligned v0+8
    v3 = load.f64 aligned v0+16
    v4 = load.f64 aligned v0+24
    v5 = load.f64 aligned v0+32
    v6 = load.f64 aligned v0+40
    v7 = load.f64 aligned v0+48
    v8 = load.f64 aligned v0+56
    v9 = load.f64 aligned v0+64
    v10 = load.f64 aligned v0+72
    v11 = load.f64 aligned v0+80
    v12 = load.f64 aligned v0+88
    v13 = load.f64 aligned v0+96
    v14 = load.f64 aligned v0+104
    v15 = load.f64 aligned v0+112
    v16 = load.f64 aligned v0+120
    v17 = load.f64 aligned v0+128
    v18 = load.f64 aligned v0+136
    v19 = load.f64 aligned v0+144
    v20 = load.f64 aligned v0+152
    v100 = fadd v1, v2
    v101 = fmul v100, v3
    v102 = fmul v101, v4
    v103 = fmul v102, v5
    v104 = fmul v103, v6
    v105 = fmul v104, v7
    v106 = fmul v105, v8
    v107 = fmul v106, v9
    v108 = fmul v107, v10
    v109 = fmul v108, v11
    v110 = fmul v109, v12
    v111 = fmul v110, v13
    v112 = fmul v111, v14
    v113 = fmul v112, v15
    v114 = fmul v113, v16
    v115 = fmul v114, v17
    v116 = fmul v115, v18
    v117 = fmul v116, v19
    v118 = fmul v117, v20
    v119 = fadd v118, v1
    v120 = fadd v119, v2
    v121 = fadd v120, v3
    v122 = fadd v121, v4
    v123 = fadd v122, v5
    v124 = fadd v123, v6
    v125 = fadd v124, v7
    v126 = fadd v125, v8
    v127 = fadd v126, v9
    v128 = fadd v127, v10
    v129 = fadd v128, v11
    v130 = fadd v129, v12
    v131 = fadd v130, v13
    v132 = fadd v131, v14
    v133 = fadd v132, v15
    v134 = fadd v133, v16
    v135 = fadd v134, v17
    v136 = fadd v135, v18
    v137 = fadd v136, v19
    v138 = fadd v137, v20
    return v138
}

