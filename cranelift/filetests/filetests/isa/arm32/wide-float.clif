function %across_call(f64, f64) -> f64 {
    fn0 = %g()

block0(v0: f64, v1: f64):
    v2 = fadd v0, v1
    v3 = fmul v0, v1
    call fn0()
    v4 = fsub v2, v3
    return v4
}

