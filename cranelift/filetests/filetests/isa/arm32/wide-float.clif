;   pop {fp, pc}

;; Vector values use q8-q15, so d16-d31 are not used for scalars here.
function %with_vector(f64x2, f64) -> f64x2 {
block0(v0: f64x2, v1: f64):
    v2 = splat.f64x2 v1
    v3 = fadd v0, v2
    return v3
}

