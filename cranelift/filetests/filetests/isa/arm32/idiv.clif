; block0: ; offset 0x0
;   cmp r1, #0
;   beq #0x10
;   udiv r0, r0, r1
;   bx lr
;   udf #0 ; trap: int_divz

function %sdiv_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = sdiv v0, v1
    return v2
}

