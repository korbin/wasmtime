test compile precise-output
set unwind_info=false
target armv7 has_idiv

function %udiv_i32(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = udiv v0, v1
    return v2
}

; VCode:
; block0:
;   cmp r1, #0
;   udfeq ; trap=int_divz
;   udiv r0, r0, r1
;   bx lr
;
