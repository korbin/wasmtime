test compile precise-output
set unwind_info=false
target armv7

function %add_shifted(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = iconst.i32 2
    v3 = ishl v1, v2
    v4 = iadd v0, v3
    return v4
}

; VCode:
; block0:
;   add r0, r0, r1, lsl #2
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   add r0, r0, r1, lsl #2
;   bx lr

function %mla(i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32):
    v3 = imul v0, v1
    v4 = iadd v3, v2
    return v4
}

; VCode:
; block0:
