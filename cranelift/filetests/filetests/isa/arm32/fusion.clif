;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   mla r0, r0, r1, r2
;   bx lr

function %mls(i32, i32, i32) -> i32 {
block0(v0: i32, v1: i32, v2: i32):
    v3 = imul v0, v1
    v4 = isub v2, v3
    return v4
}

