function %cmn(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 -5
    v2 = icmp slt v0, v1
    return v2
}

; VCode:
; block0:
;   cmn r0, #5
;   cset r0, lt
;   bx lr
;
; Disassembled:
; block0: ; offset 0x0
;   cmn r0, #5
;   mov r0, #0
;   movlt r0, #1
;   bx lr

function %cmp_int_min(i32) -> i8 {
block0(v0: i32):
    v1 = iconst.i32 0x80000000
    v2 = icmp slt v0, v1
    return v2
}

