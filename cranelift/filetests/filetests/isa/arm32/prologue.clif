test compile precise-output
set unwind_info=false
target armv7

;; Uses enough values across a call to need callee-saved core and float
;; registers.
function %clobbers(i32, f64) -> f64 {
    fn0 = colocated %g()
block0(v0: i32, v1: f64):
    v10 = iconst.i32 1
    v11 = iconst.i32 2
    v12 = iconst.i32 3
    v2 = iadd v0, v10
    v3 = iadd v0, v11
    v4 = iadd v0, v12
    v5 = fadd v1, v1
    call fn0()
    v6 = iadd v2, v3
    v7 = iadd v6, v4
    v8 = fcvt_from_sint.f64 v7
    v9 = fadd v8, v5
    return v9
}

; VCode:
;   push {r4, r5, r6, r7, fp, lr}
;   add fp, sp, #16
;   vpush {d11-d11}
; block0:
;   add r4, r0, #1
;   add r5, r0, #2
;   add r6, r0, #3
;   vadd.f64 d11, d0, d0
;   bl %g
;   add r0, r4, r5
;   add r0, r0, r6
;   vmov s0, r0
;   vcvt.f64.s32 d0, s0
;   vadd.f64 d0, d0, d11
;   vpop {d11-d11}
;   pop {r4, r5, r6, r7, fp, pc}
;
; Disassembled:
; block0: ; offset 0x0
;   push {r4, r5, r6, r7, fp, lr}
;   add fp, sp, #0x10
;   vpush {d11}
; block1: ; offset 0xc
;   add r4, r0, #1
;   add r5, r0, #2
;   add r6, r0, #3
;   vadd.f64 d11, d0, d0
;   bl #0x24 ; reloc_external Call %g 0
;   add r0, r4, r5
;   add r0, r0, r6
;   vmov s0, r0
;   vcvt.f64.s32 d0, s0
;   vadd.f64 d0, d0, d11
;   vpop {d11}
;   pop {r4, r5, r6, r7, fp, pc}

function %large_frame() -> i32 {
    ss0 = explicit_slot 0x20000
block0:
    v0 = stack_addr.i32 ss0
    v1 = load.i32 v0
    return v1
}

; VCode:
