;   sub sp, sp, #131072
; block0:
;   load_addr r1, [sp]
;   ldr r0, [r1]
;   mov sp, fp
;   pop {fp, pc}
;
; Disassembled:
; block0: ; offset 0x0
;   push {fp, lr}
;   mov fp, sp
;   sub sp, sp, #0x20000
; block1: ; offset 0xc
;   mov r1, sp
;   ldr r0, [r1] ; trap: heap_oob
;   mov sp, fp
;   pop {fp, pc}

;; Seven values live across a call use all of r4-r10; LR pads the push to an
;; even number of registers.
function %all_int_clobbers(i32) -> i32 {
    fn0 = colocated %g()
block0(v0: i32):
    v1 = load.i32 v0
    v2 = load.i32 v0+4
    v3 = load.i32 v0+8
    v4 = load.i32 v0+12
    v5 = load.i32 v0+16
    v6 = load.i32 v0+20
    v7 = load.i32 v0+24
    call fn0()
    v8 = iadd v1, v2
    v9 = iadd v8, v3
    v10 = iadd v9, v4
    v11 = iadd v10, v5
    v12 = iadd v11, v6
    v13 = iadd v12, v7
    return v13
}

